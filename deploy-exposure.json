{
  "service": "model-registry",
  "routes": [
    {
      "paths": ["/v1/packages"],
      "methods": ["POST"],
      "auth": {"kind": "machine-token"},
      "upstream_token": "model-registry-write-model-lab"
    },
    {
      "paths": ["/v1/packages"],
      "methods": ["GET", "PUT", "PATCH", "DELETE"],
      "auth": {"kind": "denied"}
    },
    {
      "paths": ["/v1/packages/*", "/v1/eval-reports/*", "/healthz", "/readyz"],
      "auth": {"kind": "denied"}
    }
  ]
}
