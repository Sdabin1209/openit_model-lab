{
  "jobs": [
    {
      "name": "backup",
      "argv": ["python", "-m", "model_lab.service", "backup"],
      "idempotent": true,
      "secret_files": ["OPENIT_BACKUP_CREDENTIALS_FILE", "OPENIT_BACKUP_REPO_PASSWORD_FILE"],
      "needs": ["models-data"],
      "env": ["OPENIT_BACKUP_URL", "OPENIT_EGRESS_PROXY"],
      "timeout_seconds": 3600
    },
    {
      "name": "restore",
      "argv": ["python", "-m", "model_lab.service", "restore"],
      "idempotent": true,
      "secret_files": ["OPENIT_BACKUP_CREDENTIALS_FILE", "OPENIT_BACKUP_REPO_PASSWORD_FILE"],
      "needs": ["models-data"],
      "env": ["OPENIT_BACKUP_URL", "OPENIT_EGRESS_PROXY"],
      "timeout_seconds": 3600
    }
  ]
}
