{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrainRecordCheckRequest",
  "description": "train_record_verify의 입력.",
  "type": "object",
  "properties": {
    "role": {
      "enum": [
        "LORA_A",
        "LORA_B"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "adapter_dir": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true,
      "required": [
        "id"
      ]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "content_hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "role",
    "path",
    "adapter_dir",
    "base",
    "dataset"
  ]
}
