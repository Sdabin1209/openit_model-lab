{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AdapterCheckRequest",
  "description": "adapter_check의 입력.",
  "type": "object",
  "properties": {
    "role": {
      "enum": [
        "LORA_A",
        "LORA_B"
      ]
    },
    "adapter_dir": {
      "type": "string",
      "minLength": 1
    },
    "base_model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "max_rank": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "role",
    "adapter_dir",
    "base_model"
  ]
}
