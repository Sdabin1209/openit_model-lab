{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DatasetRef",
  "description": "어댑터를 학습한 데이터셋의 참조(package-adapters의 --dataset-*). 계약 ArtifactRef와 같은 모양이지만 id·version은 문자열이면 된다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "content_hash"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "type": "string",
      "minLength": 1
    }
  }
}
