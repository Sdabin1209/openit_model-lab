{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_version",
    "role",
    "server",
    "base_model",
    "dataset",
    "output"
  ],
  "properties": {
    "config_version": {
      "const": 1
    },
    "role": {
      "enum": [
        "LORA_A",
        "LORA_B"
      ]
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_dir",
        "scripts"
      ],
      "properties": {
        "code_dir": {
          "type": "string",
          "minLength": 1
        },
        "scripts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "LORA_A",
            "LORA_B"
          ],
          "properties": {
            "LORA_A": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.py$"
            },
            "LORA_B": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.py$"
            }
          }
        },
        "python": {
          "type": "string",
          "minLength": 1
        },
        "require_gpu": {
          "type": "boolean"
        },
        "args_verified": {
          "type": "boolean"
        },
        "args_evidence": {
          "type": "string"
        },
        "script_sha256": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "LORA_A": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "LORA_B": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "arg_map": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-{1,2}[A-Za-z][A-Za-z0-9_-]*$"
          }
        },
        "extra_args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "python_modules": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+$"
          }
        },
        "ssh": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host"
          ],
          "properties": {
            "host": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "description": "~/.ssh/config의 호스트 이름. 없으면 이 컴퓨터가 학습 서버다"
            }
          }
        },
        "sandbox_root": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s']+$",
          "description": "server.ssh일 때 필수. 서버에서 쓰기를 허락받은 폴더(사용자 결정: ~/dabin 아래만). 정본 스크립트 사본(code/), TMPDIR, 실행 작업 폴더가 이 아래에 놓인다. ~/dabin 밖이면 doctor가 FAIL하고 train이 거부한다"
        },
        "pass_env": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "not": {
              "pattern": "_FILE$|TOKEN|SECRET|PASSWORD|KEY"
            }
          },
          "description": "자식 프로세스(ssh, rsync, 학습)에 더 넘길 환경 변수 이름(RUNTIME R9.1: 기본은 PATH, HOME, LANG, LC_ALL, SSH_AUTH_SOCK뿐). 비밀 이름은 허용하지 않는다"
        }
      }
    },
    "base_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "revision": {
          "type": "string"
        },
        "profile": {
          "$ref": "_common.schema.json#/$defs/Id"
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dir",
        "prefix",
        "id",
        "version"
      ],
      "properties": {
        "dir": {
          "type": "string",
          "minLength": 1
        },
        "prefix": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "upload_root": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s']+$",
          "description": "파이프라인(run)이 변환한 데이터를 서버에 올리는 서버 쪽 폴더. 아래에 <run_id>/<role>/을 만든다. 서버 쓰기 허락을 받은 폴더여야 하므로 기본값이 없다"
        }
      }
    },
    "hyperparams": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_dir"
      ],
      "properties": {
        "adapter_dir": {
          "type": "string",
          "minLength": 1
        },
        "record_file": {
          "type": "string"
        },
        "server_run_record": {
          "type": "string"
        },
        "min_free_gb": {
          "type": "number",
          "minimum": 0
        },
        "disk_policy": {
          "enum": [
            "block",
            "warn",
            "off"
          ]
        },
        "max_lora_rank": {
          "type": "integer",
          "minimum": 1
        },
        "server_out_dir": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s']+$",
          "description": "server.ssh일 때 서버 스크립트에 --out_dir로 넘기는 서버 쪽 폴더. 어댑터는 그 아래 adapter/에 나온다(서버 스크립트 규칙). adapter_dir로 읽기 전용 복사한다"
        },
        "expected_gb": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "upload",
            "output",
            "model_download"
          ],
          "properties": {
            "upload": {
              "type": "number",
              "minimum": 0
            },
            "output": {
              "type": "number",
              "minimum": 0
            },
            "model_download": {
              "type": "number",
              "minimum": 0
            }
          },
          "description": "server.ssh일 때 필수. 실행 전 서버 디스크 검사에 쓰는 예상 크기(GB): 업로드 데이터, 학습 산출물, 내려받을 모델. 근거는 설정 주석에 적는다. 서버 여유가 이 합의 2배 미만이면 거부한다"
        }
      }
    }
  },
  "title": "TrainWrapConfig",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "SecretFree.schema.json"
    }
  ],
  "description": "학습 서버 정본 스크립트를 감싸는 `model-lab train` 설정(configs/train*.yaml)."
}
