{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UnevaluatedReportRequest",
  "description": "evaluation_report_build(평가하지 않음, package-adapters)의 입력. 출력은 계약 EvaluationReport.",
  "type": "object",
  "properties": {
    "role": {
      "enum": [
        "LORA_A",
        "LORA_B"
      ]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "content_hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "content_hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "decoding": {
      "type": "object"
    },
    "report_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 128
    }
  },
  "additionalProperties": false,
  "required": [
    "role",
    "package",
    "dataset",
    "created_at",
    "decoding",
    "report_id"
  ]
}
