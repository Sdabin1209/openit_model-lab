{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunRecord",
  "description": "run_record가 쓰는 run.json: 설정, 시드, 데이터셋 버전, 라이브러리 버전, 단계별 결과.",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^run-[0-9a-f]{16}$"
    },
    "run_key": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "config_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "config": {
      "type": "object"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "content_hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "libraries": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "environment": {
      "type": "object"
    },
    "stages": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "load_dataset",
          "transform",
          "train",
          "evaluate",
          "package",
          "publish"
        ]
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "result": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "complete"
            },
            "packages": {
              "type": "object"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "packages"
          ]
        }
      ]
    },
    "last_error": {
      "type": "object"
    },
    "decisions": {
      "type": "object",
      "description": "게시한 패키지에 대한 release-gate 판정(I4 find_decisions) 조회 결과. status: not_configured | none | found | unavailable",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_configured",
            "none",
            "found",
            "unavailable"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "code": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "run_id",
    "run_key",
    "name",
    "created_at",
    "seed",
    "config_hash",
    "config",
    "dataset",
    "libraries",
    "environment",
    "stages",
    "result"
  ]
}
