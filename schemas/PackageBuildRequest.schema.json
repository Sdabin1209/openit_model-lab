{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PackageBuildRequest",
  "description": "package_build의 입력. dataset_manifest는 학습 파이프라인이면 계약 DatasetManifest, package-adapters(학습 서버 어댑터)면 파일 없는 {files: []}.",
  "type": "object",
  "properties": {
    "role": {
      "enum": [
        "LORA_A",
        "LORA_B"
      ]
    },
    "package_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "contract_version": {
      "type": "integer",
      "minimum": 1
    },
    "base_model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ]
    },
    "adapter_dir": {
      "type": "string",
      "minLength": 1
    },
    "serving_config": {
      "$ref": "ServingConfig.schema.json"
    },
    "dataset_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "content_hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "dataset_manifest": {
      "anyOf": [
        {
          "$ref": "DatasetManifest.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "files": {
              "type": "array",
              "maxItems": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "files"
          ]
        }
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 128
    },
    "ext": {
      "type": "object"
    },
    "system_prompt": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "role",
    "package_id",
    "version",
    "created_at",
    "contract_version",
    "base_model",
    "adapter_dir",
    "serving_config",
    "dataset_ref",
    "dataset_manifest",
    "run_id",
    "ext",
    "system_prompt"
  ]
}
