{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SecretFree",
  "description": "설정에 비밀 값이 직접 적혀 있으면 거부한다(D84). 키 이름에 token/secret/password/credential/api_key/authorization/private_key가 들어 있고 값이 문자열이면 거부한다(대소문자 무시). `*_env`로 끝나는 키는 환경 변수 *이름*을 받으므로 이름 형식 [A-Z][A-Z0-9_]+만 허용한다. 모든 깊이에 적용한다.",
  "if": {
    "type": "object"
  },
  "then": {
    "patternProperties": {
      "^(?![\\s\\S]*_[Ee][Nn][Vv]$)[\\s\\S]*(?:[Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Aa][Pp][Ii]_[Kk][Ee][Yy]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee]_[Kk][Ee][Yy])": {
        "allOf": [
          {
            "not": {
              "type": "string"
            }
          },
          {
            "$ref": "#"
          }
        ]
      },
      "^[\\s\\S]*(?:[Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Aa][Pp][Ii]_[Kk][Ee][Yy]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee]_[Kk][Ee][Yy])[\\s\\S]*_[Ee][Nn][Vv]$": {
        "if": {
          "type": "string"
        },
        "then": {
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "else": {
          "$ref": "#"
        }
      }
    },
    "additionalProperties": {
      "$ref": "#"
    }
  },
  "else": {
    "if": {
      "type": "array"
    },
    "then": {
      "items": {
        "$ref": "#"
      }
    }
  }
}
